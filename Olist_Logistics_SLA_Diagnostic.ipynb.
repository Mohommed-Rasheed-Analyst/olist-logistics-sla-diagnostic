        "late_orders_df = master_orders[master_orders['is_late'] == True].copy()\n",
        "late_orders_df['delay_tier'] = pd.cut(\n",
        "    late_orders_df['sla_variance_days'],\n",
        "    bins=[0, 3, 7, np.inf],\n",
        "    labels=[\n",
        "        'Mild Delay (1-3 Days Late)',\n",
        "        'Moderate Delay (4-7 Days Late)',\n",
        "        'Severe Delay (> 7 Days Late)',],right=True,)\n",
        "delay_financial_impact = late_orders_df.groupby('delay_tier', observed=True).agg(\n",
        "        affected_orders=('order_id', 'count'),\n",
        "        total_gmv_exposed=('price', 'sum'),\n",
        "        avg_review_score=('review_score', 'mean'),).reset_index()\n",
        "total_late_gmv = delay_financial_impact['total_gmv_exposed'].sum()\n",
        "delay_financial_impact['gmv_share_pct'] = (delay_financial_impact['total_gmv_exposed'] / total_late_gmv) * 100\n",
        "\n",
        "delay_financial_impact"
      ],
