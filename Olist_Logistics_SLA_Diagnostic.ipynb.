          "text": [
            "Delivered Orders with valid delivery date: 96,470 rows\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "date_columns = ['order_purchase_timestamp', 'order_approved_at', 'order_delivered_carrier_date', 'order_delivered_customer_date', 'order_estimated_delivery_date']\n",
        "for col in date_columns:\n",
        "  delivered_orders[col] = pd.to_datetime(delivered_orders[col])"
      ],
      "metadata": {
        "id": "XB2SN_UIPdYJ"
      },
      "execution_count": 10,
      "outputs": []
    },
    {
